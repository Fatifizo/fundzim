# =============================================================================
# FundZim environment template
# =============================================================================
# Copy to `.env` for LOCAL DEVELOPMENT ONLY:   cp .env.example .env
#
# Rules:
#   * This file contains PLACEHOLDERS ONLY. Never put a real credential here.
#   * `.env` and every `.env.*` (except this file) are git-ignored. Keep it that way.
#   * Production/staging secrets come from a secret manager and are injected at
#     runtime — never from a committed file, never baked into container images.
#   * Variables prefixed NEXT_PUBLIC_ are compiled into the browser bundle and are
#     PUBLIC. Never give a secret a NEXT_PUBLIC_ name.
#   * Values marked "<set-locally>" have no safe default; generate your own local
#     value (e.g. `openssl rand -base64 32`) and never reuse it outside your machine.
#
# Most of these are consumed from Stage 3 onwards (Go API). In Stage 0 nothing
# reads this file. See docs/DEVELOPMENT.md and docs/SECURITY.md (secrets management).
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
APP_NAME=FundZim
APP_BASE_URL=http://localhost:3000  # public web origin
API_BASE_URL=http://localhost:8080  # Go API origin (proxied to /api/v1 by the web tier)
API_LISTEN_ADDR=:8080
APP_DEFAULT_TIMEZONE=Africa/Harare  # display default only; all storage/processing is UTC
LOG_LEVEL=debug                     # debug | info | warn | error
LOG_FORMAT=text                     # text (local) | json (all deployed environments)

# Next.js (public, compiled into the browser bundle — NO secrets)
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL — the only authoritative store)
# -----------------------------------------------------------------------------
# Separate roles by design (see docs/DATABASE.md). Local compose will create them.
DATABASE_URL=postgres://fundzim_app:<set-locally>@localhost:5432/fundzim?sslmode=disable
DATABASE_MIGRATION_URL=postgres://fundzim_migrator:<set-locally>@localhost:5432/fundzim?sslmode=disable
DATABASE_KYC_URL=postgres://fundzim_kyc:<set-locally>@localhost:5432/fundzim?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_STATEMENT_TIMEOUT=15s
# Production MUST use sslmode=verify-full.

# -----------------------------------------------------------------------------
# REDIS (cache / rate limiting / coordination — NEVER authoritative)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=false                # app must degrade safely without Redis

# -----------------------------------------------------------------------------
# STORAGE (S3-compatible; MinIO locally). Two buckets, two credential sets.
# Docs use the logical names `public-media` / `private-kyc`; physical names are
# environment-prefixed as below. `private-kyc` holds KYC AND compliance documents
# (separate prefixes and access policies) — there is no third bucket.
# -----------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=local
STORAGE_FORCE_PATH_STYLE=true

# Public campaign media (served via CDN after processing)
STORAGE_PUBLIC_BUCKET=fundzim-public-media
STORAGE_PUBLIC_ACCESS_KEY_ID=<set-locally>
STORAGE_PUBLIC_SECRET_ACCESS_KEY=<set-locally>
STORAGE_PUBLIC_CDN_BASE_URL=http://localhost:9000/fundzim-public-media

# Private KYC/compliance documents (no public access; SSE with dedicated key; audited presigned access)
STORAGE_KYC_BUCKET=fundzim-private-kyc
STORAGE_KYC_ACCESS_KEY_ID=<set-locally>
STORAGE_KYC_SECRET_ACCESS_KEY=<set-locally>
STORAGE_KYC_KMS_KEY_ID=             # production: dedicated KMS key id
STORAGE_KYC_PRESIGN_TTL=5m

UPLOAD_MAX_BYTES=10485760           # 10 MiB
MALWARE_SCAN_ENABLED=true          # production refuses to boot if false
CLAMAV_ADDR=localhost:3310

# -----------------------------------------------------------------------------
# AUTH
# -----------------------------------------------------------------------------
# Timeouts are Stage 4 starting points; docs/SECURITY.md is the source of truth.
SESSION_COOKIE_NAME=fz_session      # local only: production uses __Host-fz_session (__Host- requires HTTPS)
SESSION_IDLE_TIMEOUT=168h           # 7 days
SESSION_ABSOLUTE_TIMEOUT=720h       # 30 days
STAFF_SESSION_IDLE_TIMEOUT=15m
STAFF_SESSION_ABSOLUTE_TIMEOUT=12h
STEP_UP_MAX_AGE=10m                 # freshness required for sensitive actions
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
CSRF_SECRET=<set-locally>
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# EMAIL (Mailpit locally, including Stage 4 OTP email; provider chosen Stage 15)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=FundZim <no-reply@fundzim.invalid>

# -----------------------------------------------------------------------------
# SMS (provider chosen Stage 15; Stage 4 uses the `log` fake). `log` = print OTPs to the local console only.
# -----------------------------------------------------------------------------
SMS_PROVIDER=log                    # log is REFUSED when APP_ENV=production
SMS_API_KEY=
SMS_SENDER_ID=FundZim

# -----------------------------------------------------------------------------
# PAYMENTS — no real provider exists yet. Only the sandbox provider is planned
# for development (Stage 8). Real PSP adapters arrive in Stage 9.
# -----------------------------------------------------------------------------
PAYMENTS_ENABLED_PROVIDERS=sandbox
PAYMENTS_SANDBOX_WEBHOOK_SECRET=<set-locally>
PAYMENTS_WEBHOOK_TOLERANCE=5m
PAYMENTS_ENABLED_CURRENCIES=USD,ZWG
# Per-provider variables (PAYMENTS_<PROVIDER>_*) are added with each adapter.
# They must never appear here with real values.

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=        # empty = tracing exporter disabled
OTEL_SERVICE_NAME=fundzim-api
METRICS_LISTEN_ADDR=:9090           # internal only; never exposed publicly
ERROR_REPORTING_DSN=                # empty = disabled

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Application-level encryption for C3 fields (e.g. identity numbers). Production
# uses KMS envelope encryption; the local key below is for development only.
FIELD_ENCRYPTION_PROVIDER=local     # local | kms
FIELD_ENCRYPTION_LOCAL_KEY=<set-locally>
FIELD_ENCRYPTION_KMS_KEY_ID=
BLIND_INDEX_KEY=<set-locally>       # HMAC key for searchable hashes of identity numbers
AUDIT_HASH_CHAIN_ENABLED=true       # production refuses to boot if false
RATE_LIMIT_ENABLED=true             # production refuses to boot if false
TRUSTED_PROXY_CIDRS=127.0.0.1/32
CORS_ALLOWED_ORIGINS=               # empty: API is served same-origin under /api/v1
