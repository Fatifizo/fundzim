# =============================================================================
# FundZim environment template
# =============================================================================
# LOCAL DEVELOPMENT ONLY. Create your .env with generated local secrets:
#     ./scripts/dev-env-init.sh          (never overwrites an existing .env)
#
# Rules:
#   * This file contains PLACEHOLDERS ONLY. Never put a real credential here.
#   * `.env` and every `.env.*` (except this file) are git-ignored. Keep it that way.
#   * Production/staging secrets come from a secret manager and are injected at
#     runtime — never from a committed file, never baked into container images.
#   * Variables prefixed NEXT_PUBLIC_ are compiled into the browser bundle and are
#     PUBLIC. Never give a secret a NEXT_PUBLIC_ name.
#   * <generate:...> markers are replaced by scripts/dev-env-init.sh with fresh
#     random values; ${NAME} references are expanded by the same script.
#
# The same .env serves two purposes:
#   1. docker compose interpolation (compose.yaml builds container-internal URLs itself);
#   2. running the API on the host:  set -a; . ./.env; set +a; go run ./apps/api/cmd/api
# Docs: README.md, docs/DEVELOPMENT.md, docs/stage-3/implementation.md.
# =============================================================================

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
APP_ENV=development                 # development | test | staging | production
APP_NAME=FundZim
# optional override of the build version
APP_VERSION=
HTTP_HOST=127.0.0.1                 # containers use 0.0.0.0 (set in compose.yaml)
HTTP_PORT=8080
INTERNAL_HTTP_HOST=127.0.0.1        # metrics + detailed readiness; never exposed publicly
INTERNAL_HTTP_PORT=9090
REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=20s
HTTP_MAX_BODY_BYTES=1048576         # 1 MiB
LOG_LEVEL=debug                     # debug | info | warn | error (debug refused in production)
LOG_FORMAT=text                     # text (local) | json (required outside development/test)
# empty: the API is served same-origin under /api/v1 (no CORS)
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXY_CIDRS=127.0.0.1/32    # peers whose X-Request-ID / X-Forwarded-For are accepted
RATE_LIMIT_ENABLED=true             # refused as false outside development/test
RATE_LIMIT_RPS=20                   # coarse per-client-IP limit
RATE_LIMIT_BURST=40

# Next.js
API_BASE_URL=http://127.0.0.1:8080  # server-side only: target of the web /api/v1 proxy route; never NEXT_PUBLIC_

# -----------------------------------------------------------------------------
# POSTGRESQL (the only authoritative store). Local roles are created by
# deploy/docker/postgres/init/10-roles.sh on first start of an empty volume.
# Production MUST use sslmode=verify-full (the API refuses to start otherwise).
# -----------------------------------------------------------------------------
POSTGRES_HOST_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=<generate:password>   # local container admin only; never used by FundZim
POSTGRES_MIGRATOR_PASSWORD=<generate:password>
POSTGRES_APP_PASSWORD=<generate:password>
POSTGRES_WORKER_PASSWORD=<generate:password>
POSTGRES_KYC_PASSWORD=<generate:password>
POSTGRES_COMPLIANCE_PASSWORD=<generate:password>
POSTGRES_READONLY_PASSWORD=<generate:password>
DATABASE_URL=postgres://fundzim_app:${POSTGRES_APP_PASSWORD}@127.0.0.1:5432/fundzim?sslmode=disable
DATABASE_MIGRATION_URL=postgres://fundzim_migrator:${POSTGRES_MIGRATOR_PASSWORD}@127.0.0.1:5432/fundzim?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_CONNECT_TIMEOUT=5s
# Later stages: DATABASE_WORKER_URL, DATABASE_KYC_URL, DATABASE_COMPLIANCE_URL, DATABASE_READONLY_URL

# -----------------------------------------------------------------------------
# REDIS (Valkey locally) — cache / rate limiting only, NEVER authoritative
# -----------------------------------------------------------------------------
REDIS_HOST_PORT=6379
REDIS_PASSWORD=<generate:password>
REDIS_URL=redis://:${REDIS_PASSWORD}@127.0.0.1:6379/0
REDIS_REQUIRED=false                # the API degrades safely without Redis

# -----------------------------------------------------------------------------
# OBJECT STORAGE (S3-compatible; Garage locally). Three buckets, three separately
# scoped credentials; each key can reach exactly one bucket (design-baseline I-19/I-26).
#   PUBLIC_CAMPAIGN_MEDIA        -> STORAGE_PUBLIC_*
#   PRIVATE_IDENTITY_DOCUMENTS   -> STORAGE_KYC_*       (kyc module only)
#   PRIVATE_COMPLIANCE_DOCUMENTS -> STORAGE_EVIDENCE_*  (storage module only)
# -----------------------------------------------------------------------------
STORAGE_HOST_PORT=3900
STORAGE_ENDPOINT=http://127.0.0.1:3900
STORAGE_REGION=garage
STORAGE_FORCE_PATH_STYLE=true
GARAGE_RPC_SECRET=<generate:hex32>  # local Garage cluster secret
GARAGE_ADMIN_TOKEN=<generate:hex32> # local Garage admin API token (used only by the init container)
STORAGE_PUBLIC_BUCKET=fundzim-public-media
STORAGE_PUBLIC_ACCESS_KEY_ID=<generate:garage-key-id>
STORAGE_PUBLIC_SECRET_ACCESS_KEY=<generate:hex32>
STORAGE_KYC_BUCKET=fundzim-private-kyc
STORAGE_KYC_ACCESS_KEY_ID=<generate:garage-key-id>
STORAGE_KYC_SECRET_ACCESS_KEY=<generate:hex32>
STORAGE_EVIDENCE_BUCKET=fundzim-private-evidence
STORAGE_EVIDENCE_ACCESS_KEY_ID=<generate:garage-key-id>
STORAGE_EVIDENCE_SECRET_ACCESS_KEY=<generate:hex32>
UPLOAD_MAX_BYTES=10485760           # 10 MiB (uploads arrive in Stage 5)
MALWARE_SCAN_ENABLED=true           # production refuses to boot if false (Stage 5)

# Host ports of the remaining local services
API_HOST_PORT=8080
API_INTERNAL_HOST_PORT=9090
WEB_HOST_PORT=3000
MAIL_UI_HOST_PORT=8025
MAIL_SMTP_HOST_PORT=1025

# -----------------------------------------------------------------------------
# AUTH
# -----------------------------------------------------------------------------
# Timeouts are Stage 4 starting points; docs/SECURITY.md is the source of truth.
SESSION_COOKIE_NAME=fz_session      # local only: production uses __Host-fz_session (__Host- requires HTTPS)
SESSION_IDLE_TIMEOUT=168h           # 7 days
SESSION_ABSOLUTE_TIMEOUT=720h       # 30 days
STAFF_SESSION_IDLE_TIMEOUT=15m
STAFF_SESSION_ABSOLUTE_TIMEOUT=12h
STEP_UP_MAX_AGE=10m                 # freshness required for sensitive actions
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
CSRF_SECRET=<generate:hex32>
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# EMAIL (Mailpit locally, including Stage 4 OTP email; provider chosen Stage 15)
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM="FundZim <no-reply@fundzim.invalid>"

# -----------------------------------------------------------------------------
# SMS (provider chosen Stage 15; Stage 4 uses the `log` fake). `log` = print OTPs to the local console only.
# -----------------------------------------------------------------------------
SMS_PROVIDER=log                    # log is REFUSED when APP_ENV=production
SMS_API_KEY=
SMS_SENDER_ID=FundZim

# -----------------------------------------------------------------------------
# PAYMENTS — no real provider exists yet. Only the sandbox provider is planned
# for development (Stage 8). Real PSP adapters arrive in Stage 9.
# -----------------------------------------------------------------------------
PAYMENTS_ENABLED_PROVIDERS=sandbox
PAYMENTS_SANDBOX_WEBHOOK_SECRET=<generate:hex32>
PAYMENTS_WEBHOOK_TOLERANCE=5m
PAYMENTS_ENABLED_CURRENCIES=USD,ZWG
# Per-provider variables (PAYMENTS_<PROVIDER>_*) are added with each adapter.
# They must never appear here with real values.

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
# empty = tracing exporter disabled
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=fundzim-api
# empty = disabled
ERROR_REPORTING_DSN=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# Application-level encryption for C3 fields (e.g. identity numbers). Production
# uses KMS envelope encryption; the local key below is for development only.
FIELD_ENCRYPTION_PROVIDER=local     # local | kms
FIELD_ENCRYPTION_LOCAL_KEY=<generate:hex32>
FIELD_ENCRYPTION_KMS_KEY_ID=
BLIND_INDEX_KEY=<generate:hex32>    # HMAC key for searchable hashes of identity numbers
AUDIT_HASH_CHAIN_ENABLED=true       # production refuses to boot if false
